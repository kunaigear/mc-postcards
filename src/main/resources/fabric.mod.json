{
  "schemaVersion": 1,
  "id": "postcards",
  "version": "${version}",
  "name": "Postcards",
  "description": "Players place virtual cameras with /postcard set. Every day the server renders what each camera sees and posts the picture to a webhook.",
  "authors": ["kunaigear"],
  "license": "AGPL-3.0-only",
  "contact": {
    "homepage": "https://github.com/kunaigear/mc-postcards",
    "sources": "https://github.com/kunaigear/mc-postcards",
    "issues": "https://github.com/kunaigear/mc-postcards/issues"
  },
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.kunaigear.postcards.Postcards"]
  },
  "mixins": ["postcards.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "polymer-resource-pack": "*",
    "polymer-virtual-entity": "*",
    "java": ">=25"
  }
}
