{
  "schemaVersion": 1,
  "id": "dailycams",
  "version": "${version}",
  "name": "Daily Cams",
  "description": "Players place virtual cameras with /dailycam set. Every day the server renders what each camera sees and posts the picture to a webhook.",
  "authors": ["kunaigear"],
  "license": ["MIT", "AGPL-3.0-only"],
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.kunaigear.dailycams.DailyCams"]
  },
  "mixins": ["dailycams.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "polymer-resource-pack": "*",
    "polymer-virtual-entity": "*",
    "java": ">=25"
  }
}
