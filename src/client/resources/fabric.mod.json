{
  "schemaVersion": 1,
  "id": "postcards-client",
  "version": "${version}",
  "name": "Postcards Client",
  "description": "Optional client helper for Postcards: /postcard set uses your FOV setting, and with a freecam mod places the camera where your view is, not where your body is.",
  "authors": ["kunaigear"],
  "license": "MIT",
  "contact": {
    "homepage": "https://github.com/kunaigear/mc-postcards",
    "sources": "https://github.com/kunaigear/mc-postcards",
    "issues": "https://github.com/kunaigear/mc-postcards/issues"
  },
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.kunaigear.postcards.client.PostcardsClient"]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  },
  "suggests": {
    "freecam": "*"
  }
}
